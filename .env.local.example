# Elastic Cloud Serverless
ELASTIC_URL=
ELASTIC_API_KEY=

# Google Maps Platform
# One API key — enable Maps JavaScript, Geocoding, and Routes APIs on it
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
USE_AGENT_BUILDER=false

# Google Cloud (only needed when USE_AGENT_BUILDER=true)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_REGION=europe-west3
VERTEX_AI_AGENT_ID=
